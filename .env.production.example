# ============================================================
# BRANDX FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# ============================================================

# Production API Endpoint (HTTPS only - never localhost in production)
VITE_API_URL="https://api.yourdomain.com/api/v1"

# Production App URL
APP_URL="https://app.yourdomain.com"

# Firebase Authentication (Firebase Web Client SDK)
# Project ID: brandx-cdi-2026
VITE_FIREBASE_API_KEY="REPLACE_WITH_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="brandx-cdi-2026.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="brandx-cdi-2026"
VITE_FIREBASE_STORAGE_BUCKET="brandx-cdi-2026.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="REPLACE_WITH_FIREBASE_APP_ID"
