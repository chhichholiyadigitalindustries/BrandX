# ============================================================
# BRANDX BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# All-in-One Business Super App for Indian Vyaparis & MSMEs
# ============================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# PostgreSQL Database (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brandx_db?schema=public"

# Security & JSON Web Tokens
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Admin Portal Security
ADMIN_JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Google Gemini AI Integration
# Securely stored on backend only - never exposed to clients
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_MAX_RETRIES=2
GEMINI_BASE_DELAY_MS=1000
GEMINI_MAX_DELAY_MS=8000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=20000
AI_FREE_DAILY_LIMIT=20
AI_PRO_DAILY_LIMIT=100

# Cloud Object Storage (S3 / Cloudflare R2 / GCP Cloud Storage)
STORAGE_DRIVER=local
STORAGE_BUCKET=brandx-media-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=

# Payment Gateway (Razorpay / Cashfree / PhonePe PG)
PAYMENT_GATEWAY=razorpay
PAYMENT_PROVIDER_KEY=rzp_test_placeholder_key
PAYMENT_PROVIDER_SECRET=rzp_test_placeholder_secret
PAYMENT_WEBHOOK_SECRET=whsec_placeholder_secret

# SMS / OTP Provider (Twilio / Msg91 / Fast2SMS)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=BRANDX

# Business Defaults
DEFAULT_INVOICE_PREFIX=INV
DEFAULT_CURRENCY=INR

# Firebase Authentication (Firebase Admin SDK)
# Project ID: brandx-cdi-2026 (alias: brandx)
FIREBASE_PROJECT_ID=brandx-cdi-2026
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
