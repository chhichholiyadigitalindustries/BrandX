# ============================================================
# BRANDX BACKEND PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# DO NOT COMMIT REAL SECRETS TO REPOSITORY.
# ============================================================

# Environment
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.yourdomain.com,https://yourdomain.com

# PostgreSQL Database (Cloud PostgreSQL with SSL)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Security & JSON Web Tokens (Must be cryptographically strong, min 32 characters)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Admin Portal Security (Must be cryptographically strong, min 32 characters)
ADMIN_JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Google Gemini AI Integration (Managed on backend only)
GEMINI_API_KEY=REPLACE_WITH_PRODUCTION_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_MAX_RETRIES=2
GEMINI_BASE_DELAY_MS=1000
GEMINI_MAX_DELAY_MS=8000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=30000
AI_FREE_DAILY_LIMIT=20
AI_PRO_DAILY_LIMIT=100

# Cloud Object Storage (S3 / R2 / GCS)
STORAGE_DRIVER=s3
STORAGE_BUCKET=brandx-media-production
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_STORAGE_SECRET_KEY
STORAGE_ENDPOINT=

# Payment Gateway (Razorpay Production Keys)
PAYMENT_GATEWAY=razorpay
PAYMENT_PROVIDER_KEY=rzp_live_REPLACE_WITH_KEY_ID
PAYMENT_PROVIDER_SECRET=REPLACE_WITH_KEY_SECRET
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
PAYMENT_CURRENCY=INR

# SMS / WhatsApp Notification Provider
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=BRANDX

# Business Defaults
DEFAULT_INVOICE_PREFIX=INV
DEFAULT_CURRENCY=INR

# Firebase Authentication (Firebase Admin SDK Service Account)
# Project ID: brandx-cdi-2026
FIREBASE_PROJECT_ID=brandx-cdi-2026
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
